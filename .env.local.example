# Anthropic (aus console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (aus supabase.com → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://[deine-projekt-id].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key]
SUPABASE_SERVICE_ROLE_KEY=[service-role-key]

# ThriveCart Webhook (vor Launch eintragen)
THRIVECART_WEBHOOK_SECRET=[webhook-secret-aus-thrivecart]

# Feedback-Digest (täglicher E-Mail-Versand via Resend)
# RESEND_API_KEY aus resend.com → API Keys (ein Konto reicht für alle Projekte)
RESEND_API_KEY=re_...
# CRON_SECRET: zufälligen String generieren; Vercel sendet ihn automatisch als Bearer-Token an den Cron
CRON_SECRET=[zufaelliger-string]
